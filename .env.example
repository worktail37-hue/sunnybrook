# OWNER_EMAIL: Required for admin dashboard access and receiving lead notifications.
# Must match the verified Google account email used by the clinic owner.
OWNER_EMAIL="owner@example.com"

# EMAIL_API_KEY: API key for Resend (re_...) or SendGrid (SG....) to send instant lead notification emails.
EMAIL_API_KEY="YOUR_RESEND_OR_SENDGRID_API_KEY"

# EMAIL_FROM: Verified sender address for outbound notification emails (optional, defaults to onboarding@resend.dev).
EMAIL_FROM="notifications@yourdomain.com"

# FIREBASE_SERVICE_ACCOUNT: Optional JSON string of Firebase service account key if running outside Google Cloud / AI Studio default credentials.
FIREBASE_SERVICE_ACCOUNT=""

# IP_HASH_SALT: Secret random string used to salt SHA-256 hashes of visitor IP addresses for rate-limiting and duplicate protection.
IP_HASH_SALT="replace_with_a_long_random_secret_salt_string"

# TURNSTILE_SECRET: Optional Cloudflare Turnstile secret key for server-side bot verification.
TURNSTILE_SECRET=""

# VITE_TURNSTILE_SITE_KEY: Optional Cloudflare Turnstile public site key for frontend widget rendering.
VITE_TURNSTILE_SITE_KEY=""

# APP_URL: The public URL where this application is hosted.
APP_URL="http://localhost:3000"
